# ─── Frontend environment variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (already in .gitignore).

# Google Gemini API keys — all 3 rotate automatically on quota errors.
# Get yours at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY_1=your_gemini_api_key_1_here
VITE_GEMINI_API_KEY_2=your_gemini_api_key_2_here
VITE_GEMINI_API_KEY_3=your_gemini_api_key_3_here

# Groq API keys — FREE fallback when all Gemini keys are rate-limited.
# Get yours at https://console.groq.com (free tier: ~14400 req/day per key)
VITE_GROQ_API_KEY_1=your_groq_api_key_1_here
VITE_GROQ_API_KEY_2=your_groq_api_key_2_here
VITE_GROQ_API_KEY_3=your_groq_api_key_3_here

# URL of the FastAPI RAG backend (no trailing slash).
# Local dev  → http://localhost:8001
# Render     → https://medchat-backend.onrender.com
# HF Spaces  → https://your-space.hf.space
VITE_RAG_API_URL=http://localhost:8001
