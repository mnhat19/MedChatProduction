# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Install deps first (layer cache)
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .
# Vite bakes VITE_* vars into the JS bundle at build time — pass both keys as build-args
ARG VITE_GEMINI_API_KEY_1
ARG VITE_GEMINI_API_KEY_2
ARG VITE_GEMINI_API_KEY_3
ARG VITE_RAG_API_URL
ENV VITE_GEMINI_API_KEY_1=$VITE_GEMINI_API_KEY_1
ENV VITE_GEMINI_API_KEY_2=$VITE_GEMINI_API_KEY_2
ENV VITE_GEMINI_API_KEY_3=$VITE_GEMINI_API_KEY_3
ENV VITE_RAG_API_URL=$VITE_RAG_API_URL
RUN npm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
